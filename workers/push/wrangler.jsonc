{
  // Fahrplan-Push (heute https://orbis-trains.malte9799.workers.dev/). Der Name darf sich nicht ändern.
  "name": "orbis-trains",
  "main": "src/index.js",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "keep_vars": true, // schützt nur im Dashboard gesetzte Variablen, die NICHT in dieser Datei stehen
  "vars": { "ALLOWED_ORIGINS": "https://maltee.dev,https://malte9799.github.io,http://localhost:5173,http://localhost:4173" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    { "binding": "DB", "database_name": "orbis-push", "database_id": "aa4b53d8-a690-4130-81ec-a36b01dd2d11", "migrations_dir": "migrations" }
  ]
  // Im Dashboard setzen (nicht hier):
  //   Secrets: DB_CLIENT_ID, DB_API_KEY, VAPID_PUBLIC, VAPID_PRIVATE
  //   Text:    VAPID_SUBJECT (mailto:...), DB_TIMETABLES_BASE (optional)
}
