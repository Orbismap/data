{
  "name": "orbis-data",
  "private": true,
  "description": "Datenpipelines, Worker und Speicher für Orbis",
  "scripts": {
    "deploy:proxy": "wrangler deploy -c workers/proxy/wrangler.jsonc",
    "deploy:push": "wrangler deploy -c workers/push/wrangler.jsonc",
    "deploy:camdir": "wrangler deploy -c workers/camdir/wrangler.jsonc",
    "deploy:clock": "wrangler deploy -c workers/clock/wrangler.jsonc",
    "collect": "node collectors/build.mjs && node dist/fetch-data.mjs",
    "build:collectors": "node collectors/build.mjs"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "wrangler": "4.157.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "pbf": "^5.1.2"
  }
}
